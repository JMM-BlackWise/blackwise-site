{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/advisors",
      "destination": "/#advisors",
      "permanent": false
    },
    {
      "source": "/cpa",
      "destination": "/#advisors",
      "permanent": false
    },
    {
      "source": "/financial-advisors",
      "destination": "/#financial-advisors",
      "permanent": false
    },
    {
      "source": "/planners",
      "destination": "/#financial-advisors",
      "permanent": false
    },
    {
      "source": "/cfp",
      "destination": "/#financial-advisors",
      "permanent": false
    },
    {
      "source": "/investment-advisors",
      "destination": "/#investment-advisors",
      "permanent": false
    },
    {
      "source": "/ria",
      "destination": "/#investment-advisors",
      "permanent": false
    },
    {
      "source": "/cfa",
      "destination": "/#investment-advisors",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
